# Pinned sibling checkouts for reproducible release builds.
# Update these SHAs when intentionally bumping IndigoNakamoto/bdk or rust-litecoin.
BDK_REPO=IndigoNakamoto/bdk
# The crates/mweb security hardening pass. The wallet-side code depends on it
# (SealContext, VerifyMode::Anchored default), so this cannot move back.
# db9fa957 adds the F-01 anchoring evidence: passed mainnet probe (F-01f),
# mainnet header_hash known-answer test (F-01a), and Litecoin Core source
# citations for the HogEx commitment.
# d8e220c2 survives the MWEB serving rate limit that litecoind 0.21.5.6 added
# (F-21). This one is also load-bearing in the other direction: wallet-core
# matches on BanReason::Throttled to keep a metered node instead of defecting
# to public peers, and that variant does not exist before b6ca6f40.
BDK_REF=d8e220c20da06bbda212f21ced7544aad54ab1a7
# bdk_wallet is a separate repo that lives at bdk/bdk_wallet (gitignored inside bdk),
# so CI must check it out on its own. Note that bdk_wallet's own CI cannot build
# it — every job is a bare checkout, but all its deps are relative paths to
# ../crates and ../../rust-litecoin — so this pin is the only thing that decides
# which bdk_wallet ever gets compiled against this wallet.
# df19027d is ec309d24 plus rustfmt reflow and import sorting, no semantic
# change. Pinned anyway so CI builds the same bytes as a local checkout.
BDK_WALLET_REPO=IndigoNakamoto/bdk_wallet
BDK_WALLET_REF=df19027d45db0050c26edb1aaf4e27230a690bc6
RUST_LITECOIN_REPO=IndigoNakamoto/rust-litecoin
RUST_LITECOIN_REF=0b3285337f3cc508a5549d245ce20d3b52418f3a
