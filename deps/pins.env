# Pinned sibling checkouts for reproducible release builds.
# Update these SHAs when intentionally bumping IndigoNakamoto/bdk or rust-litecoin.
BDK_REPO=IndigoNakamoto/bdk
# The crates/mweb security hardening pass. The wallet-side code depends on it
# (SealContext, VerifyMode::Anchored default), so this cannot move back.
BDK_REF=f5c8e7ac665ced875c880494e5956e8748713f0e
# bdk_wallet is a separate repo that lives at bdk/bdk_wallet (gitignored inside bdk),
# so CI must check it out on its own.
BDK_WALLET_REPO=IndigoNakamoto/bdk_wallet
BDK_WALLET_REF=ec309d2421684ea3488fc2b6431d880d392106d9
RUST_LITECOIN_REPO=IndigoNakamoto/rust-litecoin
RUST_LITECOIN_REF=0b3285337f3cc508a5549d245ce20d3b52418f3a
