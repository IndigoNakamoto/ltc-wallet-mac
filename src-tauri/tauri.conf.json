{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LTC Wallet",
  "version": "0.1.0",
  "identifier": "com.indigonakamoto.ltc-wallet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LTC Wallet",
        "width": 880,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Finance",
    "shortDescription": "Native Litecoin wallet for macOS",
    "longDescription": "BIP84 transparent Litecoin wallet with Electrum sync and optional MWEB privacy features.",
    "copyright": "Copyright © Indigo Nakamoto",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "signingIdentity": null,
      "entitlements": "Entitlements.plist"
    }
  }
}
